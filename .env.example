# Copy to .env. Never add real secrets to this file or to Git.
COMPOSE_PROJECT_NAME=zhijiao
APP_BIND_HOST=127.0.0.1
APP_PORT=3000
# Production: replace with your trusted HTTPS reverse proxy's exact origin.
APP_ORIGIN=https://zhijiao.example.invalid
NODE_ENV=production
# Enable only for a trusted single-hop reverse proxy that replaces forwarded headers.
TRUST_PROXY=0
APP_IMAGE=zhijiao:local
DATABASE_USER=zhijiao
DATABASE_NAME=zhijiao
DATABASE_PASSWORD_PATH=./.local/secrets/db-password
SESSION_SECRET_PATH=./.local/secrets/session-secret
# Optional DeepSeek analysis: use compose.yaml + compose.deepseek.yaml together.
# Write the key to this ignored secret file; never put the key itself here.
DEEPSEEK_API_KEY_PATH=./.local/secrets/deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
INTERACTION_AI_TIMEOUT_MS=60000
# Ops scripts use BACKUP_DIR and AGE_RECIPIENT_FILE from the calling environment,
# not this Compose file. No backup destination or schedule has been configured.
